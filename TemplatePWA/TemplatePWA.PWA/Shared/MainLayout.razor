@inject WorkspaceService WorkspaceService
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService
@inject NavigationManager Navigation
@implements IDisposable
@inherits LayoutComponentBase
@using TemplatePWA.PWA.Helpers
@using TemplatePWA.PWA.Shared.Workspace
@using TemplatePWA.PWA.Shared.Common
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing

<MudThemeProvider Theme="@_customTheme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<div class="mesh-bg"></div>

<MudLayout>
    <MudAppBar Elevation="0" Fixed="true" Class="modern-appbar" Style="background-color: #A50A3A;">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge">
            <div class="d-flex align-center justify-space-between">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.LocationCity" Size="Size.Large" Class="mr-3" Style="color: white;" />
                    <MudText Typo="Typo.h5" Style="font-weight: bold; color: white;">
                        Engrama Template
                    </MudText>
                </div>

                <div class="d-none d-md-flex">
                    <MudButton Href="/" Color="Color.Inherit" Class="nav-button mx-2" Style="color: white;">
                        Inicio
                    </MudButton>
                    <MudButton Href="/guia-engrama-core" Color="Color.Inherit" Class="nav-button mx-2" Style="color: white;">
                        Guía EngramaCore
                    </MudButton>
                </div>

                <div class="d-md-none">
                    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="@ToggleMobileMenu" Style="color: white;" />
                </div>
            </div>
        </MudContainer>
    </MudAppBar>

    <MudCollapse Expanded="@_mobileMenuOpen" Class="mobile-menu">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Style="background-color: #A50A3A; padding: 1rem;">
            <MudStack Spacing="2">
                <MudButton Href="/" Color="Color.Inherit" FullWidth="true" Style="color: white; justify-content: flex-start;" OnClick="@CloseMobileMenu">
                    <MudIcon Icon="@Icons.Material.Filled.Home" Class="mr-3" />
                    Inicio
                </MudButton>
                <MudButton Href="/guia-engrama-core" Color="Color.Inherit" FullWidth="true" Style="color: white; justify-content: flex-start;" OnClick="@CloseMobileMenu">
                    <MudIcon Icon="@Icons.Material.Filled.MenuBook" Class="mr-3" />
                    Guía EngramaCore
                </MudButton>
            </MudStack>
        </MudContainer>
    </MudCollapse>

    <MudMainContent Style="padding-top: 80px; min-height: calc(100vh - 80px); background-color: transparent;">
        @if (ShowWorkspaceTabs)
        {
            <ToolbarSuperior OnCloseTab="CloseCurrentTabAsync" />

            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" 
                     Class="glass-effect mx-4 mt-2 mb-4"
                     Style="border-radius: 16px; overflow: hidden;"
                     ActivePanelIndex="tabsSelectedIndex" 
                     ActivePanelIndexChanged="OnTabChanged">
                @foreach (var tab in tabsList)
                {
                    <MudTabPanel ID="@tab.Id.ToString()">
                        <ChildContent>
                            <div class="pa-4">
                                <DynamicComponent Type="tab.TipoControl" Parameters="tab.Parameters" />
                            </div>
                        </ChildContent>
                        <TabContent>
                            <MudMenu ActivationEvent="@MouseEvent.RightClick" PositionAtCursor="true" AnchorOrigin="Origin.BottomCenter">
                                <ActivatorContent>
                                    <div class="d-flex align-center px-4 py-2" style="cursor: pointer; min-width: 120px;">
                                        <MudIcon Icon="@tab.Icono" Class="mr-2" Size="Size.Small" />
                                        <MudText Typo="Typo.body2" Style="white-space: nowrap;">@tab.Text</MudText>
                                        <span @onclick:stopPropagation="true">
                                            <MudIconButton Icon="@Icons.Material.Filled.Close" 
                                                           Size="Size.Small" 
                                                           Class="ml-2 pa-1" 
                                                           OnClick="@(() => CloseTabAsync(tab))" />
                                        </span>
                                    </div>
                                </ActivatorContent>
                                <ChildContent>
                                    <MudMenuItem Icon="@Icons.Material.Filled.Close" OnClick="@(() => CloseTabAsync(tab))">Cerrar pestaña</MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.CloseFullscreen" OnClick="@(() => CloseOtherTabsAsync(tab))">Cerrar las demás</MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.DeleteSweep" OnClick="CloseAllTabsAsync" Disabled="@(tabsList.Count <= 1)">Cerrar todas</MudMenuItem>
                                </ChildContent>
                            </MudMenu>
                        </TabContent>
                    </MudTabPanel>
                }
            </MudTabs> 
        }
        else
        {
            @Body
        }
    </MudMainContent>
</MudLayout>

@code {
    private bool _mobileMenuOpen = false;
    private List<WorkspaceTab> tabsList = new List<WorkspaceTab>();
    private int tabsSelectedIndex = 0;

    /// <summary>
    /// Doc/static routes always use @Body so the EngramaCore guide is reachable even if tabs are open.
    /// </summary>
    private bool IsDocsRoute =>
        Navigation.ToBaseRelativePath(Navigation.Uri)
            .StartsWith("guia-engrama-core", StringComparison.OrdinalIgnoreCase);

    private bool ShowWorkspaceTabs => tabsList.Count != 0 && !IsDocsRoute;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        WorkspaceService.OnMenuTabSelected += AddTab;
        WorkspaceService.MenuChanged += OnMenuChanged;
        WorkspaceService.TabNameChanged += RenameCurrentTab;
        WorkspaceService.TabStateChanged += SetTabState;
        WorkspaceService.CloseCurrentTab += OnCloseCurrentTabRequested;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        WorkspaceService.OnMenuTabSelected -= AddTab;
        WorkspaceService.MenuChanged -= OnMenuChanged;
        WorkspaceService.TabNameChanged -= RenameCurrentTab;
        WorkspaceService.TabStateChanged -= SetTabState;
        WorkspaceService.CloseCurrentTab -= OnCloseCurrentTabRequested;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private void OnMenuChanged() => InvokeAsync(StateHasChanged);

    private void OnCloseCurrentTabRequested(bool withWarning) =>
        InvokeAsync(CloseCurrentTabAsync);

    private void RenameCurrentTab(string tabName, string iconText)
    {
        if (tabsList.Any() && tabsSelectedIndex < tabsList.Count)
        {
            tabsList[tabsSelectedIndex].Text = tabName;
            tabsList[tabsSelectedIndex].Icono = iconText;
            base.StateHasChanged();
        }
    }

    private void SetTabState(TipoEstadoControl tabState)
    {
        if (tabsList.Any() && tabsSelectedIndex < tabsList.Count)
        {
            tabsList[tabsSelectedIndex].EstadoControl = tabState;
        }
    }

    private void OnTabChanged(int index)
    {
        if (index >= 0 && index < tabsList.Count)
        {
            tabsSelectedIndex = index;
        }
    }

    private void AddTab(WorkspaceTab tab)
    {
        if (tab.Parameters != null
            && tab.Parameters.TryGetValue("EstadoControl", out var estadoParam)
            && estadoParam is TipoEstadoControl estado)
        {
            tab.EstadoControl = estado;
        }

        var identity = tab.GetIdentityKey();
        var existing = tabsList.FirstOrDefault(t => t.GetIdentityKey() == identity);
        if (existing != null)
        {
            tabsSelectedIndex = tabsList.IndexOf(existing);
            StateHasChanged();
            return;
        }

        tabsList.Add(tab);
        tabsSelectedIndex = tabsList.Count - 1;
        base.StateHasChanged();
    }

    private Task CloseCurrentTabAsync()
    {
        if (!tabsList.Any() || tabsSelectedIndex < 0 || tabsSelectedIndex >= tabsList.Count)
        {
            return Task.CompletedTask;
        }

        return CloseTabAsync(tabsList[tabsSelectedIndex]);
    }

    private Task CloseTabAsync(WorkspaceTab tab)
    {
        var index = tabsList.IndexOf(tab);
        if (index < 0)
        {
            return Task.CompletedTask;
        }

        tabsList.RemoveAt(index);

        if (tabsList.Count == 0)
        {
            tabsSelectedIndex = 0;
            WorkspaceService.SetMenuItems(new List<MenuItemModel>());
        }
        else if (index < tabsSelectedIndex)
        {
            tabsSelectedIndex--;
        }
        else if (tabsSelectedIndex >= tabsList.Count)
        {
            tabsSelectedIndex = tabsList.Count - 1;
        }

        base.StateHasChanged();
        return Task.CompletedTask;
    }

    private void CloseOtherTabsAsync(WorkspaceTab keepTab)
    {
        tabsList.Clear();
        tabsList.Add(keepTab);
        tabsSelectedIndex = 0;
        StateHasChanged();
    }

    private void CloseAllTabsAsync()
    {
        tabsList.Clear();
        tabsSelectedIndex = 0;
        WorkspaceService.SetMenuItems(new List<MenuItemModel>());
        StateHasChanged();
    }

    private void ToggleMobileMenu()
    {
        _mobileMenuOpen = !_mobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        _mobileMenuOpen = false;
    }

    private MudTheme _customTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#A50A3A",
            Secondary = "#2b2b2b",
            AppbarBackground = "#A50A3A",
            Background = "#F8FAFC",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#1E293B",
            TextPrimary = "#1E293B",
            TextSecondary = "#64748B",
            ActionDefault = "#0f172a",
            PrimaryContrastText = "#FFFFFF",
            Success = "#10B981",
            Warning = "#F59E0B",
            Error = "#EF4444",
            Info = "#3B82F6"
        }
    };
}
